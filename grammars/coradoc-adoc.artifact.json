"// tag::section-name[]","expect":{}},{"entry":"document","kind":"accept","input":"include::file.adoc[leveloffset=1]","expect":{}}],"docs":{},"source":"# Coradoc AsciiDoc grammar — PARG port (parsanol-ruby#129 acceptance).\n#\n# Translation of coradoc-adoc/lib/coradoc/asciidoc/parser (Ruby Parsanol\n# DSL) to .parg. Ported incrementally; each rule family cites its Ruby\n# source. The motivating runtime-state patterns (fence capture + dynamic\n# close, from Parser::Block#block_style / #markdown_code_block) map onto\n# set/state exactly as designed in parsanol-ruby#129.\n#\n# Increment 1 scope: terminals, attribute lists (faithful capture\n# shapes), element ids, block titles, block headers, all delimited\n# block styles (verbatim content), comments/tags/includes, document\n# dispatch subset with the unparsed catch-all.\n\ngrammar CoradocAdoc version \"0.2.0\" {\n\n  # ---- text.rb terminals ----\n  any_char = %x01-10FFFF\n  space = 1*\" \"\n  sp = [1*\" \"]\n  text = 1*(!\"\\n\" any_char)\n  line_ending = (\"\\n\" / \"\\r\\n\")\n  newline = 1*(\"\\n\" / \"\\r\\n\")\n  empty_line = \"\\n\"\n  keyword = 1*(%x41-5A / %x61-7A / %x30-39 / \"_\" / \"-\" / \".\" / \",\")\n  file_path = 1*(!\"[\" any_char)\n\n  # ---- attribute_list.rb (faithful capture shapes) ----\n  named_key = (1*(%x41-5A / %x61-7A / %x30-39 / \"_\" / \"-\")) as named_key\n\n  named_value_sq = %x27 (1*(!(%x27) any_char)) %x27\n  named_value_dq = %x22 (1*(!(%x22) any_char)) %x22\n  named_value_noquote = 1*(!(%x5D / %x2C) any_char)\n  named_value = ((named_value_sq / named_value_dq / named_value_noquote)) as named_value\n\n  named_attribute = ((named_key [space] \"=\" [space] named_value [space])) as named\n\n  positional_value_sq = %x27 (1*(!(%x27) any_char)) %x27\n  positional_value_dq = %x22 (1*(!(%x22) any_char)) %x22\n  positional_value_unquoted = 1*(!(%x5D / %x2C / %x3D) any_char)\n  positional_attribute = (((positional_value_sq / positional_value_dq / positional_value_unquoted) !(%x3D))) as positional\n\n  named_many = ((1*1(named_attribute)) [*(%x2C [space] named_attribute)])\n  positional_one_named_many = ((1*1(positional_attribute)) 1*(%x2C [space] named_attribute))\n  positional_many_named_many = ((1*1(positional_attribute)) 1*(%x2C [space] positional_attribute) 1*(%x2C [space] named_attribute))\n  positional_many = ((1*1(positional_attribute)) [*(%x2C [space] positional_attribute)])\n  positional_zero_or_one = 0*1(positional_attribute)\n\n  attribute_list = (&(%x5B) %x5B !(%x5B) (((((named_many / positional_one_named_many / positional_many_named_many / positional_many / positional_zero_or_one))) as attribute_array)) as attribute_list %x5D)\n\n  # ---- content.rb: element_id / block_header.rb ----\n  element_id = (((\"[[\" (keyword) as id \"]]\") / (\"[#\" (keyword) as id \"]\")) newline)\n\n  attribute_blocks = (1*((attribute_list newline))) as attribute_list\n\n  # ---- block.rb: delimiters + title ----\n  block_delim_run = 4*((%x2A / %x3D / %x5F / %x2B / %x2E / %x2D))\n  block_delimiter = ((block_delim_run / (2%x2D) / (3*%x60)) newline)\n  block_title = (!(block_delimiter) %x2E !(space) (text) as title newline)\n\n  block_header = [(block_title)] [(element_id)] [(attribute_blocks)]\n\n  # ---- text.rb: comment_line / tag / comment_block / include ----\n  tag_shape = (\"//\" !( \"/\") [1*\" \"] (\"tag\" / \"end\") \"::\" !( \":\") 1*(!\"[\" any_char))\n\n  comment_line_content = (!(tag_shape) \"//\" !(\"/\") [1*\" \"] *(!\"\\n\" any_char) line_ending)\n\n  comment_line = (!(tag_shape) (\"//\" !(\"/\") [1*\" \"] [(text) as comment_text line_ending as line_break])) as comment_line\n\n  tag = ((\"//\" !(\"/\") [1*\" \"] (\"tag\" / \"end\") as prefix \"::\" !(\":\") ((1*(!\"[\" any_char))) as name attribute_list [newline] as line_break)) as tag\n\n  comment_block = ((\"////\" line_ending (*(!((line_ending \"////\")) any_char)) as comment_text line_ending \"////\")) as comment_block\n\n  include_directive = ((\"include::\" file_path as path attribute_list [newline] as line_break)) as include\n\n  # ---- content.rb text_line(verbatim:) : text + own line ending ----\n  # tl >> (line_ending.as(:line_break) | eof?) — the newline rides INSIDE\n  # the same iteration hash (parslet sequence merge), matching the DSL.\n  verbatim_line = (((1*(!\"\\n\" any_char)) as text) ((line_ending) as line_break / (!(any_char))))\n\n  # ---- block.rb: delimited blocks (the #129 state patterns) ----\n  # markdown_code_block: 3+ backticks, optional language, closes with the\n  # SAME fence run (Parser::Block#markdown_code_block).\n  state md_fence: string\n  md_lang = [*\" \" (1*(%x41-5A / %x61-7A / %x30-39 / \"_\" / \"+\" / \"-\" / \".\")) as language]\n  md_close = (state md_fence [space] newline)\n  md_content = (!(md_close) verbatim_line)\n  md_break = (empty_line as line_break)\n  markdown_code_block = (block_header ((set md_fence = (3*%x60)) as delimiter md_lang newline (1*(md_content / md_break)) as lines [space] (state md_fence) [space] newline))\n\n  # block_style: 4+ identical fence chars, closes with the exact same run.\n  state eq_fence: string\n  state dash_fence: string\n  state us_fence: string\n  state ast_fence: string\n  state plus_fence: string\n  state dot_fence: string\n\n  eq_content = (!(((state eq_fence) newline)) verbatim_line)\n  dash_content = (!(((state dash_fence) newline)) verbatim_line)\n  us_content = (!(((state us_fence) newline)) verbatim_line)\n  ast_content = (!(((state ast_fence) newline)) verbatim_line)\n  plus_content = (!(((state plus_fence) newline)) verbatim_line)\n  dot_content = (!(((state dot_fence) newline)) verbatim_line)\n  vbreak = (empty_line as line_break)\n\n  example_block = (block_header ((set eq_fence = (4*%x3D)) as delimiter newline (1*(eq_content / vbreak)) as lines (state eq_fence) newline))\n  source_block = (block_header ((set dash_fence = (4*%x2D)) as delimiter newline (1*(dash_content / vbreak)) as lines (state dash_fence) newline))\n  quote_block = (block_header ((set us_fence = (4*%x5F)) as delimiter newline (1*(us_content / vbreak)) as lines (state us_fence) newline))\n  sidebar_block = (block_header ((set ast_fence = (4*%x2A)) as delimiter newline (1*(ast_content / vbreak)) as lines (state ast_fence) newline))\n  pass_block = (block_header ((set plus_fence = (4*%x2B)) as delimiter newline (1*(plus_content / vbreak)) as lines (state plus_fence) newline))\n  literal_block = (block_header ((set dot_fence = (4*%x2E)) as delimiter newline (1*(dot_content / vbreak)) as lines (state dot_fence) newline))\n\n  # block_style_exact: open block — EXACTLY 2 dashes\n  state open_fence: string\n  open_content = (!(((state open_fence) newline)) verbatim_line)\n  open_block = (block_header ((set open_fence = (2%x2D)) as delimiter newline (1*(open_content / vbreak)) as lines (state open_fence) newline))\n\n  block = ((markdown_code_block / example_block / sidebar_block / source_block / quote_block / pass_block / literal_block / open_block)) as block\n\n  # ---- base.rb rule(:document) — ported members in Ruby order ----\n  # the repetition itself is the capture: parenthesize so `as` binds to\n  # the star, not the body (per-iteration capture would fragment the tree)\n  document = (*(block / comment_block / comment_line / include_directive / tag / (empty_line as line_break) / (any_char as unparsed))) as document\n\n  entry document: document\n\n  test {\n    accept \"----\\ncode\\n----\"\n    accept \"----\\ncode\\n----\\n----\\nmore\\n----\"\n    accept \"------\\ncode\\n------\"\n    accept \"```ruby\\nputs 1\\n```\"\n    accept \"````\\n```\\n````\"\n    accept \".Title\\n----\\ncode\\n----\"\n    accept \"[source, ruby]\\n----\\nx = 1\\n----\"\n    accept \"////\\nblock comment\\n////\"\n    accept \"// tag::section-name[]\"\n    accept \"include::file.adoc[leveloffset=1]\"\n  }\n}\n","states":{"md_fence":"string","eq_fence":"string","dash_fence":"string","us_fence":"string","ast_fence":"string","plus_fence":"string","dot_fence":"string","open_fence":"string"},"dynamic":true,"checksum":"sha256:71f4f3de1b4f8353630991250324a17906d2bb4132404a542b061f0b96634719"}
